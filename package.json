{
  "name": "@nexar/backend",
  "version": "0.1.0",
  "description": "NEXAR \u2014 Confidential Intelligence Protocol for Hierarchical Economic Routing. Backend infrastructure layer built on Story Protocol + CDR.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./sdk": "./dist/src/sdk/index.js",
    "./auth": "./dist/src/auth/index.js",
    "./licensing": "./dist/src/licensing/index.js",
    "./runtime": "./dist/src/runtime/index.js",
    "./agents": "./dist/src/agents/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "compile": "npx hardhat --config hardhat.config.cjs compile",
    "deploy": "node scripts/deploy.cjs",
    "setup": "node scripts/setup.cjs",
    "verify": "node scripts/verify.cjs",
    "demo": "node demo/run.mjs",
    "demo:film": "node --loader ts-node/esm demo/scenarios/film-nda.ts",
    "demo:quant": "node --loader ts-node/esm demo/scenarios/quant-market.ts",
    "demo:inference": "node --loader ts-node/esm demo/scenarios/inference-market.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "npx hardhat --config hardhat.config.cjs test",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:all": "npm run test:contracts && npm test"
  },
  "dependencies": {
    "@story-protocol/core-sdk": "^1.2.0",
    "@piplabs/cdr-sdk": "^0.2.1",
    "viem": "^2.21.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "better-sqlite3": "^9.4.3",
    "@pinata/sdk": "^2.1.0",
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/node": "^22.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "hardhat": "^2.22.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ts-node": "^10.9.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "@types/better-sqlite3": "^7.6.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
