# ─── Wallet ───────────────────────────────────────────────────────────────────
# Private key of the deployer / primary operator wallet (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# ─── Network ──────────────────────────────────────────────────────────────────
# Story Aeneid testnet RPC (public endpoint, no key required)
RPC_URL=https://aeneid.storyrpc.io

# CDR Story-API REST endpoint (for DKG state and validator queries)
CDR_API_URL=http://172.192.41.96:1317

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens in SessionManager.ts
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ─── NEXAR Custom Contracts (filled in after running: npm run deploy) ────────
REPUTATION_REGISTRY_ADDR=0x0000000000000000000000000000000000000000
DYNAMIC_PRICING_HOOK_ADDR=0x0000000000000000000000000000000000000000
INFERENCE_CONDITION_ADDR=0x0000000000000000000000000000000000000000
NEXAR_REGISTRY_ADDR=0x0000000000000000000000000000000000000000

# ─── SPG NFT Collection (filled in after running: npm run setup) ──────────────
# The SPGNFT collection used for minting IP asset NFTs
NEXAR_SPG_NFT_ADDR=0x0000000000000000000000000000000000000000

# ─── Story Protocol Core (Aeneid — do not change) ────────────────────────────
IP_ASSET_REGISTRY=0x77319B4031e6eF1250907aa00018B8B1c67a244b
LICENSING_MODULE=0x04fbd8a2e56dd85CFD5500A4A4DfA955B9f1dE6f
LICENSE_TOKEN=0xFe3838BFb30B34170F00030B52eA4893d8aAC6bC
PIL_TEMPLATE=0x2E896b0b2Fdb7457499B56AAaA4AE55BCB4Cd316
ROYALTY_MODULE=0xD2f60c40fEbccf6311f8B47c4f2Ec6b040400086
ROYALTY_POLICY_LAP=0xBe54FB168b3c982b7AaE60dB6CF75Bd8447b390E
ROYALTY_POLICY_LRP=0x9156e603C949481883B1d3355c6f1132D191fC41
GROUPING_MODULE=0x69D3a7aa9edb72Bc226E745A7cCdd50D947b69Ac
EVEN_SPLIT_GROUP_POOL=0xf96f2c30b41Cb6e0290de43C8528ae83d4f33F89
ACCESS_CONTROLLER=0xcCF37d0a503Ee1D4C11208672e622ed3DFB2275a
DISPUTE_MODULE=0x9b7A9c70AFF961C799110954fc06F3093aeb94C5

# ─── SPG Periphery (Aeneid — do not change) ───────────────────────────────────
REGISTRATION_WORKFLOWS=0xbe39E1C756e921BD25DF86e7AAa31106d1eb0424
LICENSE_ATTACHMENT_WORKFLOWS=0xcC2E862bCee5B6036Db0de6E06Ae87e524a79fd8
DERIVATIVE_WORKFLOWS=0x9e2d496f72C547C2C535B167e06ED8729B374a4f
GROUPING_WORKFLOWS=0xD7c0beb3aa4DCD4723465f1ecAd045676c24CDCd
ROYALTY_WORKFLOWS=0x9515faE61E0c0447C6AC6dEe5628A2097aFE1890
ROYALTY_TOKEN_DISTRIBUTION_WORKFLOWS=0xa38f42B8d33809917f23997B8423054aAB97322C

# ─── CDR Contracts (Aeneid — do not change) ───────────────────────────────────
CDR_CORE=0xCcCcCC0000000000000000000000000000000004
CDR_OWNER_WRITE_CONDITION=0x4C9bFC96d7092b590D497A191826C3dA2277c34B
CDR_LICENSE_READ_CONDITION=0xC0640AD4CF2CaA9914C8e5C44234359a9102f7a3

# ─── Tokens (Aeneid — do not change) ─────────────────────────────────────────
WIP_TOKEN=0x1514000000000000000000000000000000000000
MERC20_TOKEN=0xF2104833d386a2734a4eB3B8ad6FC6812F29E38E

# ─── Relayer ──────────────────────────────────────────────────────────────────
# Separate EOA for gas sponsorship — fund with ~1 $IP, keep separate from deployer
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./nexar.db

# ─── Pinata (IPFS pinning) ────────────────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt

# ─── HuggingFace (wired later) ───────────────────────────────────────────────
HF_API_TOKEN=your_huggingface_token
HF_MODEL_ID=your_model_id

# ─── Privy (server-side MPC wallets) ─────────────────────────────────────────
# Get from: https://dashboard.privy.io → Settings → API Keys
# With these set: wallets use Privy MPC (private key never on our server)
# Without these: wallets use local AES-encrypted SQLite (dev mode)
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ─── Pinata gateway (optional — defaults to public gateway) ──────────────────
# Use your dedicated gateway for faster/more reliable access
# Format: https://your-subdomain.mypinata.cloud
PINATA_GATEWAY=https://olive-mad-hummingbird-277.mypinata.cloud
